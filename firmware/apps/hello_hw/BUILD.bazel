"""hello_hw: board bring-up demo for NUCLEO-H743ZI2 (see main.c)."""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools:firmware.bzl", "firmware_image")

cc_binary(
    name = "hello_hw_elf",
    srcs = [
        "faults.c",
        "faults.h",
        "hw.c",
        "hw.h",
        "irq.c",
        "main.c",
        "pwm.c",
        "pwm.h",
        "syscalls.c",
    ],
    additional_linker_inputs = ["//bsp:linker_script"],
    copts = [
        "-Wextra",
        "-Wshadow",
        "-Werror",
    ],
    linkopts = [
        "-T$(location //bsp:linker_script)",
        "-lm",
    ],
    target_compatible_with = ["@platforms//os:none"],
    deps = ["//bsp:current"],
)

# out: hello_hw.elf / .bin / .hex / .lst / .size.txt
firmware_image(
    name = "hello_hw",
    elf = ":hello_hw_elf",
    target_compatible_with = ["@platforms//os:none"],
)
