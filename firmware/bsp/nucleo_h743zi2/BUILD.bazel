"""Board support for ST NUCLEO-H743ZI2 (STM32H743ZIT6, LQFP144)."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Selects the MCU for the ST CMSIS device headers.
cc_library(
    name = "mcu_config",
    defines = ["STM32H743xx"],
)

# HAL module selection and oscillator values.
cc_library(
    name = "hal_conf",
    hdrs = ["stm32h7xx_hal_conf.h"],
    defines = ["USE_HAL_DRIVER"],
    includes = ["."],
    deps = [":mcu_config"],
)

# Pin map for the board.
cc_library(
    name = "board",
    hdrs = ["board.h"],
    includes = ["."],
)

# 8 MHz from the ST-LINK's MCO rather than a crystal, which is the one thing
# this board's clock tree does differently.
cc_library(
    name = "clock",
    srcs = ["clock.c"],
    deps = [
        "//bsp:clock_api",
        "@stm32h7xx_hal_driver//:hal",
    ],
)

# Everything a bare-metal app on this board links against.
cc_library(
    name = "current",
    deps = [
        ":board",
        ":clock",
        "@cmsis_device_h7//:startup_stm32h743",
        "@stm32h7xx_hal_driver//:hal",
    ],
)
