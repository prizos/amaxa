# Pinned tool downloads and the atopile virtualenv
/.tools/
/.venv/
# Generated build outputs
*/build/
/out/
# KiCad local state
*.kicad_prl
*-backups/
fp-info-cache
*.lck
# DRC report, regenerated by `make drc`
*/elec/layout/*/drc.json
# Python bytecode from the checks and layout descriptions
__pycache__/

# Generated KiCad files. tools/board.py writes them, tools/layout.py places and
# routes them, and pcbnew fills the pours - so their exact bytes depend on which
# KiCad patch release last touched them. The design lives in <board>/led12.py,
# <board>/parts.py and <board>/layout.py; these are output. See README.md,
# "What is committed".
*/elec/
# Rendered simulation decks
*/sim/.run/


# SKiDL writes an ERC report and a log beside wherever it is run
*.erc
skidl_*.log
*/led12.log
*.log

# SKiDL schematic output, attempted and rejected; see README.md
*.kicad_sch
*-erc.rpt
