# led12 design rules: intent, not manufacturability.
#
# Concatenated after hw/fab/pcbway.kicad_dru into the board's own .kicad_dru,
# so the fab limits apply underneath everything here. `make -C hw rules`
# regenerates it; the result is committed so DRC can run without a build.

# The fuse is rated 1 A, so nothing downstream of it can carry more than that
# for long. 0.5 mm of 1 oz copper carries 1 A at about a 10 degree rise.
(rule "fused power nets"
	(condition "A.NetClass == 'Default' && (A.NetName == '12V' || A.NetName == 'GND' || A.NetName == 'VIN_FUSED' || A.NetName == 'LED_RETURN')")
	(constraint track_width (min 0.5mm))
	(severity error))

# Ahead of the fuse there is no current limit at all until it opens, and a fuse
# passes a great deal while it is deciding to. This track must not be the fuse.
(rule "unfused input"
	(condition "A.NetName == 'VIN_RAW'")
	(constraint track_width (min 1.0mm))
	(severity error))

# Signals carry microamps; the width is for handling and etch tolerance, not
# for current.
(rule "signal tracks"
	(condition "A.NetName == 'GATE' || A.NetName == 'BTN' || A.NetName == 'RPP_GATE' || A.NetName == '3V3'")
	(constraint track_width (min 0.25mm))
	(severity error))

# The board is powered from a screw terminal a person wires by hand, so the
# input pair gets more clearance than the fab floor: a stray strand of wire
# should not be able to bridge the rail to ground.
(rule "input terminal clearance"
	(condition "A.NetName == 'VIN_RAW' && B.NetName == 'GND'")
	(constraint clearance (min 0.5mm))
	(severity error))
