"""
0805 thick-film resistors, 1 %, 125 mW.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `R0805`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in R0805.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import Resistor
import is_atomic_part
import has_part_picked

component _Res0805 from Resistor:
    """Shared package body: ratings and pad mapping. Not used directly."""
    assert max_power within 125mW
    assert max_voltage within 150V
    unnamed[0] ~ pin 1
    unnamed[1] ~ pin 2

component Res2k2 from _Res0805:
    """2.2 k — LED series resistor. Sized for power, not brightness: see R0805.md."""
    trait is_atomic_part<manufacturer="Yageo", partnumber="RC0805FR-072K2L", footprint="R_0805_2012Metric.kicad_mod", symbol="Device:R">
    trait has_part_picked<manufacturer="Yageo", partno="RC0805FR-072K2L", supplier_partno="C114561", supplier_id="lcsc">
    assert resistance within 2.2kohm +/- 1%

component Res10k from _Res0805:
    """10 k — button series resistor, sets the debounce charge time."""
    trait is_atomic_part<manufacturer="Yageo", partnumber="RC0805FR-0710KL", footprint="R_0805_2012Metric.kicad_mod", symbol="Device:R">
    trait has_part_picked<manufacturer="Yageo", partno="RC0805FR-0710KL", supplier_partno="C84376", supplier_id="lcsc">
    assert resistance within 10kohm +/- 1%

component Res100k from _Res0805:
    """100 k — gate pulldown, and the reverse-polarity FET gate resistor."""
    trait is_atomic_part<manufacturer="Yageo", partnumber="RC0805FR-07100KL", footprint="R_0805_2012Metric.kicad_mod", symbol="Device:R">
    trait has_part_picked<manufacturer="Yageo", partno="RC0805FR-07100KL", supplier_partno="C96346", supplier_id="lcsc">
    assert resistance within 100kohm +/- 1%

component Res3k3 from _Res0805:
    """3.3 k — fixed load on the 3.3 V rail, so the rail is measurable."""
    trait is_atomic_part<manufacturer="Yageo", partnumber="RC0805FR-073K3L", footprint="R_0805_2012Metric.kicad_mod", symbol="Device:R">
    trait has_part_picked<manufacturer="Yageo", partno="RC0805FR-073K3L", supplier_partno="C114531", supplier_id="lcsc">
    assert resistance within 3.3kohm +/- 1%
