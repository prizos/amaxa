"""
SOT-23 MOSFETs, both polarities.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `SOT23`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in SOT23.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import MOSFET
import is_atomic_part
import has_part_picked

component _Sot23Fet from MOSFET:
    """Shared SOT-23 pad mapping: 1 = gate, 2 = source, 3 = drain."""
    gate ~ pin 1
    source ~ pin 2
    drain ~ pin 3

component PFetRpp from _Sot23Fet:
    """
    AO3407A P-channel, -30 V. Reverse-polarity pass element on the 12 V input.

    Not the Si2301 first drawn. In this circuit the gate sits at ground while
    the source is at the input, so V_gs equals the full rail: -13.2 V at the
    top of the range. The Si2301 is rated +/-8 V on the gate, so it would have
    been over-stressed in normal operation, not just during a surge. Its -20 V
    drain rating also sat below the TVS clamping voltage of 19.9 V.

    The AO3407A clears both: +/-20 V on the gate and -30 V drain to source.
    """
    trait is_atomic_part<manufacturer="Alpha & Omega Semiconductor", partnumber="AO3407A", footprint="SOT-23.kicad_mod", symbol="Device:Q_PMOS_GSD">
    trait has_part_picked<manufacturer="Alpha & Omega Semiconductor", partno="AO3407A", supplier_partno="C15155", supplier_id="lcsc">
    assert max_drain_source_voltage within 30V
    assert max_continuous_drain_current within 4.3A
    assert on_resistance within 48mohm

component NFetSwitch from _Sot23Fet:
    """2N7002 N-channel, 60 V, 115 mA. Low-side switch for the LED return."""
    trait is_atomic_part<manufacturer="onsemi", partnumber="2N7002LT1G", footprint="SOT-23.kicad_mod", symbol="Device:Q_NMOS_GSD">
    trait has_part_picked<manufacturer="onsemi", partno="2N7002LT1G", supplier_partno="C16338", supplier_id="lcsc">
    assert max_drain_source_voltage within 60V
    assert max_continuous_drain_current within 115mA
    assert gate_source_threshold_voltage within 1V to 2.5V
