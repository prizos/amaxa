"""
1210 bulk ceramic capacitor.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `C1210`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in C1210.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import Capacitor
import is_atomic_part
import has_part_picked

component CapBulk from Capacitor:
    """Bulk capacitance on the protected 12 V rail."""
    trait is_atomic_part<manufacturer="Samsung", partnumber="CL32A107MQVNNNE", footprint="C_1210_3225Metric.kicad_mod", symbol="Device:C">
    trait has_part_picked<manufacturer="Samsung", partno="CL32A107MQVNNNE", supplier_partno="C59461", supplier_id="lcsc">
    assert capacitance within 100uF +/- 20%
    assert max_voltage within 25V
    unnamed[0] ~ pin 1
    unnamed[1] ~ pin 2
