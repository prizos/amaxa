"""
SMB transient-voltage suppressor.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `SMB`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in SMB.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import Diode
import is_atomic_part
import has_part_picked

component TvsSmbj12A from Diode:
    """
    SMBJ12A unidirectional TVS, 12 V standoff. Pad 1 cathode, pad 2 anode.

    Breakdown and clamping voltage are not parameters of the standard Diode
    type, so they live in SMB.md and are checked in hw/checks/ instead.
    """
    trait is_atomic_part<manufacturer="Littelfuse", partnumber="SMBJ12A", footprint="D_SMB.kicad_mod", symbol="Device:D_TVS">
    trait has_part_picked<manufacturer="Littelfuse", partno="SMBJ12A", supplier_partno="C908463", supplier_id="lcsc">
    assert reverse_working_voltage within 12V
    cathode ~ pin 1
    anode ~ pin 2
