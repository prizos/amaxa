"""
SMB transient-voltage suppressor.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `SMB`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in SMB.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import Diode
import is_atomic_part
import has_part_picked

component TvsSmbj12A from Diode:
    """
    SMBJ12A unidirectional TVS, 12 V standoff. Pad 1 cathode, pad 2 anode.

    Breakdown and clamping voltage are not parameters of the standard Diode
    type, so they live in SMB.md and are checked in hw/checks/ instead:
    14.7 V breakdown, 19.9 V clamping at 30.2 A, 600 W for 10/1000 us.

    Brightking rather than Littelfuse: LCSC's Littelfuse SMBJ12A listing
    carries SMBJ13A parameters (13 V standoff, 21.5 V clamp), so either the
    listing or the stock is the wrong part.
    """
    trait is_atomic_part<manufacturer="Brightking", partnumber="SMBJ12A/TR13", footprint="D_SMB.kicad_mod", symbol="Device:D_TVS">
    trait has_part_picked<manufacturer="Brightking", partno="SMBJ12A/TR13", supplier_partno="C111091", supplier_id="lcsc">
    assert reverse_working_voltage within 12V

    # Not parameters of the standard Diode type, but the 12 V rail is designed
    # around them, so they are declared here rather than written into a check.
    v_breakdown_min: V
    assert v_breakdown_min within 14.7V
    v_clamp_max: V
    assert v_clamp_max within 19.9V

    cathode ~ pin 1
    anode ~ pin 2
