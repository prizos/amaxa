"""
0805 indicator LED.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `LED0805`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in LED0805.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import LED
import is_atomic_part
import has_part_picked

component LedRed from LED:
    """
    Red 0805 indicator. Pad 1 is the cathode, pad 2 the anode.

    Chosen for a bounded forward voltage: 2.0 to 2.4 V at 20 mA, from the
    datasheet. The cheaper alternatives are specified 1.6 to 2.6 V, which is
    too wide to size a series resistor against.
    """
    trait is_atomic_part<manufacturer="Everlight", partnumber="17-21SURC/S530-A3/4T", footprint="LED_0805_2012Metric.kicad_mod", symbol="Device:LED">
    trait has_part_picked<manufacturer="Everlight", partno="17-21SURC/S530-A3/4T", supplier_partno="C2943978", supplier_id="lcsc">
    assert diode.forward_voltage within 2.0V to 2.4V
    assert diode.max_current within 20mA
    diode.cathode ~ pin 1
    diode.anode ~ pin 2
