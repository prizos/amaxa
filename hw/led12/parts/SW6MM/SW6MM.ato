"""
6 mm tactile switch.

Hand-written part definitions. The footprint file beside this one is the KiCad
library `SW6MM`, which atopile registers from this directory's name. Datasheet
revision and the pin mapping checked against it are recorded in SW6MM.md.

Each part asserts its own datasheet values, so a board that asks for something
this part cannot do resolves to an `<empty>` spec, which the build gate rejects.
"""


import is_atomic_part
import has_designator_prefix
import has_part_picked

component Button6mm:
    """
    6 mm x 6 mm through-hole tactile switch, 4 leads in two poles.

    Pin 1 and pin 2 are the two poles, which is what the circuit switches
    between. Note the geometry, because it is the opposite of the obvious
    guess: the leads 6.5 mm apart are internally connected to each other, and
    the two independent poles are the leads 4.5 mm apart. KiCad numbers the
    four holes 1, 1, 2, 2 accordingly.

    The Alps SKHHAKA010 first drawn is real (LCSC C139754) but barely stocked.
    """
    trait is_atomic_part<manufacturer="Korean Hroparts Elec", partnumber="K2-1102DP-C4SW-04", footprint="SW_PUSH_6mm.kicad_mod", symbol="Switch:SW_Push">
    trait has_designator_prefix<prefix="SW">
    trait has_part_picked<manufacturer="Korean Hroparts Elec", partno="K2-1102DP-C4SW-04", supplier_partno="C110153", supplier_id="lcsc">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
