# cpu1 design rules: intent, not manufacturability.
#
# Concatenated after hw/fab/pcbway.kicad_dru into the board's own .kicad_dru.
# Net names are matched with KiCad's * wildcard, grouped by what the nets carry;
# a rule matching every net would say nothing, and a check rejects one.

# The logic rail and ground carry the MCU's whole supply current.
(rule "supply rails"
	(condition "A.NetName == '3V3' || A.NetName == 'GND'")
	(constraint track_width (min 0.2mm))
	(severity error))

# The MCU's own supply and reference pins: VDDA, VREF+ and the core regulator's
# capacitor pins, short and never necked down to a signal width.
(rule "mcu supply pins"
	(condition "A.NetName == 'VDDA' || A.NetName == 'VREF+' || A.NetName == 'VCAP*'")
	(constraint track_width (min 0.2mm))
	(severity error))

# Everything the MCU drives or reads: microamps to milliamps, so the width is
# for etch tolerance, and 0.15 mm leaves room to escape a 0.5 mm-pitch package.
(rule "mcu signals"
	(condition "A.NetName == 'SW*' || A.NetName == 'HSE_*' || A.NetName == 'LSE_*' || A.NetName == 'BOOT0' || A.NetName == 'NRST' || A.NetName == 'CONSOLE_*' || A.NetName == 'LED_*' || A.NetName == 'BUTTON' || A.NetName == 'PWM*' || A.NetName == 'TRIP*' || A.NetName == 'FAULT*' || A.NetName == 'GATE_ENABLE' || A.NetName == 'RELAY_*' || A.NetName == 'STO*' || A.NetName == 'ID_STRAP*' || A.NetName == 'DAC_*' || A.NetName == 'ENC_*' || A.NetName == 'HALL_*' || A.NetName == 'USB_*' || A.NetName == 'CAN_*' || A.NetName == 'ETH_*' || A.NetName == 'RS485_*'")
	(constraint track_width (min 0.15mm))
	(severity error))

# Analog inputs: the same width, named apart because their rules will diverge
# once the input networks exist.
(rule "analog inputs"
	(condition "A.NetName == 'IA' || A.NetName == 'IB' || A.NetName == 'IC' || A.NetName == 'VDC' || A.NetName == 'VA' || A.NetName == 'VB' || A.NetName == 'VC' || A.NetName == 'AUX_FAST' || A.NetName == 'SLOW*' || A.NetName == 'BOARD_ID*' || A.NetName == 'OV_COMP'")
	(constraint track_width (min 0.15mm))
	(severity error))

# The input rail, from the terminal to the 100 V buck. It carries the whole
# board's current at the lowest input voltage - half an amp - and it is the one
# rail a surge reaches, so it is the widest thing on the board.
(rule "input rail"
	(condition "A.NetName == 'VIN' || A.NetName == 'VIN_RAW' || A.NetName == 'VIN_FUSED'")
	(constraint track_width (min 0.4mm))
	(severity error))

# The 5 V rail and both switch nodes. The switch nodes carry the same current as
# the rail and swing the fastest edges on the board, so they are kept wide and
# short rather than necked down.
(rule "regulator power"
	(condition "A.NetName == '5V' || A.NetName == 'SW_5V' || A.NetName == 'SW_3V3'")
	(constraint track_width (min 0.3mm))
	(severity error))

# What sets each regulator: feedback, ripple injection, on-time, lockout and the
# bootstrap. Microamps, but the on-time and feedback nodes are the two the
# datasheets ask to keep short and away from the switch node.
(rule "regulator signals"
	(condition "A.NetName == 'FB_*' || A.NetName == 'BST_*' || A.NetName == 'RAMP' || A.NetName == 'RON' || A.NetName == 'UVLO' || A.NetName == 'PGOOD' || A.NetName == 'RPP_GATE'")
	(constraint track_width (min 0.15mm))
	(severity error))

# The safety chain's own nets: the buffered copies of every PWM output, the
# gate enable that travels with them, and the latch's three. The buffered side
# drives a cable to a gate driver, so it is wider than the MCU-side signal it
# copies; the latch's nets are short and on-board.
(rule "safety chain"
	(condition "A.NetName == 'GATE_ENABLE_B' || A.NetName == 'GATE_ENABLE_OUT' || A.NetName == 'TRIP_SET_N' || A.NetName == 'TRIPPED'")
	(constraint track_width (min 0.2mm))
	(severity error))

# What arrives from the power board, before anything has been done to it, and
# the thresholds it is compared against. These are the measurement: an etch
# tolerance on a 0.15 mm track is a percent of its resistance, and a percent of
# a current-sense signal is a percent of every number the control loop sees.
(rule "analog inputs from the power board"
	(condition "A.NetName == '*_SENSE' || A.NetName == 'I_TRIP_HIGH' || A.NetName == 'I_TRIP_LOW' || A.NetName == 'VDC_TRIP' || A.NetName == 'DAC_SPARE'")
	(constraint track_width (min 0.2mm))
	(severity error))

# The analog supply the power board's sensors run from, and the comparator
# outputs on their way to the trip bus.
(rule "analog supply"
	(condition "A.NetName == '5VA'")
	(constraint track_width (min 0.3mm))
	(severity error))

# The two field buses, from each transceiver to the three pins it leaves on.
# They are differential pairs leaving the board on a cable, so they are wider
# than a signal that stays on it, and the two halves of each pair are the same
# width as each other - a difference in width is a difference in impedance, and
# the impedance is the only thing a terminated bus cares about.
(rule "field buses"
	(condition "A.NetName == 'CAN_H' || A.NetName == 'CAN_L' || A.NetName == 'RS485_A' || A.NetName == 'RS485_B'")
	(constraint track_width (min 0.2mm))
	(severity error))

# The USB pair. Wider than a signal that stays on the board, because its width
# is what makes it 90 ohm over the prepreg beneath it rather than a number
# chosen for etch tolerance. DRC enforces the floor; `test_usb.py` is what
# decides the figure, from the stackup, and checks this rule against it.
(rule "usb pair"
	(condition "A.NetName == 'USB_DP' || A.NetName == 'USB_DM'")
	(constraint track_width (min 0.25mm))
	(severity error))
